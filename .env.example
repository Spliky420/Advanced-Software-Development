# Copy to .env and adjust. Compose reads .env from this directory automatically.
#
#   cp .env.example .env
#
# .env is gitignored, so every teammate copies this file once. The values here
# are also the built-in defaults in docker-compose.yml, so the stack still
# comes up without a .env.

# Model tag used by every student's backend. Must be pulled INTO the ollama
# container first (a host-pulled model is not visible to it):
#
#   docker compose exec ollama ollama pull qwen2.5:0.5b
#
# qwen2.5:0.5b  -- default, ~400MB, fast local development
# llama3.1:8b   -- higher-quality option for the demo, ~4.9GB. Switch to it by
#                  setting OLLAMA_MODEL below, but pull it into the container
#                  first or /api/insights will fail with a 404:
#
#   docker compose exec ollama ollama pull llama3.1:8b
#
OLLAMA_MODEL=qwen2.5:0.5b

# Embedding model tag used by Enerel's backend for /api/documents/search and
# for indexing a document's chunks (POST/PUT /api/documents). A chat model
# like qwen2.5:0.5b can answer Ollama's /api/embeddings endpoint, but a model
# built for embeddings gives much better retrieval quality, so this is a
# separate tag from OLLAMA_MODEL. Must be pulled into the container first:
#
#   docker compose exec ollama ollama pull nomic-embed-text
#
# Until it is pulled, document create/edit still succeeds (indexing just
# fails softly), but /api/documents/search returns a 503 naming the missing
# model and the pull command.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Drift threshold in percentage points for Joshua's /api/drift-review.
DRIFT_THRESHOLD_PERCENT=5

# Base URL of the shared Ollama service, as seen from inside the compose
# network. Joshua's and Enerel's backends read OLLAMA_BASE_URL; Maxwell's
# reads OLLAMA_HOST. Both name the same service (http://ollama:11434) --
# keep them in step if either changes.
OLLAMA_HOST=http://ollama:11434
