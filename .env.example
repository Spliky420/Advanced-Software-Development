# Copy to .env and adjust. Compose reads .env from this directory automatically.
#
#   cp .env.example .env
#
# .env is gitignored, so every teammate copies this file once. The values here
# are also the built-in defaults in docker-compose.yml, so the stack still
# comes up without a .env.

# Model tag used by every student's backend. Ollama (AI-Mode) runs on the
# host, not in compose, so pull models with the host's ollama CLI:
#
#   ollama pull qwen2.5:0.5b
#
# qwen2.5:0.5b  -- default, ~400MB, fast local development
# llama3.1:8b   -- higher-quality option for the demo, ~4.9GB. Switch to it by
#                  setting OLLAMA_MODEL below, but pull it first or
#                  /api/insights will fail with a 404:
#
#   ollama pull llama3.1:8b
#
OLLAMA_MODEL=qwen2.5:0.5b

# Embedding model tag used by Enerel's backend for /api/documents/search and
# for indexing a document's chunks (POST/PUT /api/documents). A chat model
# like qwen2.5:0.5b can answer Ollama's /api/embeddings endpoint, but a model
# built for embeddings gives much better retrieval quality, so this is a
# separate tag from OLLAMA_MODEL. Must be pulled first:
#
#   ollama pull nomic-embed-text
#
# Until it is pulled, document create/edit still succeeds (indexing just
# fails softly), but /api/documents/search returns a 503 naming the missing
# model and the pull command.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Drift threshold in percentage points for Joshua's /api/drift-review.
DRIFT_THRESHOLD_PERCENT=5

# AI-Mode (Ollama), the MCP server and the RAG server all run on the host,
# not in compose (Release 1 brief). These are the URLs every backend
# container uses to reach them; the defaults in docker-compose.yml match.
# On a Linux engine, start Ollama with OLLAMA_HOST=0.0.0.0 so containers can
# reach it through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
MCP_SERVER_URL=http://host.docker.internal:5002/mcp
MCP_HARNESS_URL=http://host.docker.internal:5001
RAG_SERVER_URL=http://host.docker.internal:5003
